{
  "name": "repwise",
  "private": true,
  "version": "1.0.0",
  "description": "Weekly home workout planner built around your equipment, time, focus, and goal.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "homepage": "https://repwiseapp.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheMambi/repwise.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "pretest": "node scripts/install-hooks.mjs --check",
    "test": "npm run test:node && npm run test:scanner",
    "test:node": "node --test tests/planner.test.ts tests/page.test.ts tests/install-hooks.test.mjs",
    "test:scanner": "node scripts/python.mjs -m unittest discover -s tests -p \"test_*.py\"",
    "prepare": "node scripts/install-hooks.mjs",
    "hooks:check": "node scripts/install-hooks.mjs --check",
    "scan:secrets": "node scripts/python.mjs .githooks/scan-secrets.py --all"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
